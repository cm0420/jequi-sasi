{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend-projeto-tadeu/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TROQUE-PELO-BACKEND.exemplo.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://TROQUE-PELO-BACKEND.exemplo.com/auth/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
